# Configuración genérica; entorno explícito prevalece. Token solo en env.secret.
SONAR_HOST_URL=
SONAR_PROJECT_KEY=srcds-autocomplete
SONAR_PROJECT_NAME=srcds-autocomplete
SONAR_SOURCE_ENCODING=UTF-8
SONAR_SOURCES=extension,scripts
SONAR_EXCLUSIONS=**/__pycache__/**
SONAR_CXX_FILE_SUFFIXES=.c,.cc,.cpp,.cxx,.h,.hh,.hpp,.hxx
SONAR_CXX_ERROR_RECOVERY_ENABLED=false
SONAR_QUALITY_GATE_WAIT=true
SONAR_QUALITY_GATE_TIMEOUT=300
SONAR_COMPILE_COMMANDS=
SONAR_CPPCHECK=cppcheck
SONAR_SCANNER=sonar-scanner
# Seleccionar dependencias/salidas con LINUX_* / WINDOWS_* en Make.
# VCVARSALL_PATH puede seleccionar vcvarsall.bat en Windows.
# Recibos de cobertura real (opcionales), ligados a fuentes y pruebas actuales.
SONAR_COVERAGE_RECEIPT=
SONAR_PYTHON_COVERAGE_RECEIPT=
